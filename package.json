{
  "name": "sherlock-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sherlock: AI Code Review Security Agent with Deterministic SAST, Reachability Triage, and Verification Engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --prefix packages/dashboard",
    "start": "npm run dev --prefix packages/dashboard",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sherlock": "node packages/cli/dist/index.js",
    "scan": "node packages/cli/dist/index.js scan benchmark/vulnerable-app",
    "mcp": "node packages/cli/dist/index.js mcp"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
